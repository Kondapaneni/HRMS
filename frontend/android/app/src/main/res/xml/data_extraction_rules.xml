<?xml version="1.0" encoding="utf-8"?>
<!-- SEC-006: prohibit Android 12+ cloud backup and device-to-device transfer
     of HRMS app storage, including auth/attendance records. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
