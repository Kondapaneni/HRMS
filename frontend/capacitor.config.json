{
  "appId": "com.example.acmehrms",
  "appName": "Acme HRMS",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://hrms-qwv3.onrender.com",
    "androidScheme": "https",
    "cleartext": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    },
    "SplashScreen": {
      "launchShowDuration": 30000,
      "launchAutoHide": false,
      "backgroundColor": "#f8fafd",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#FFFFFF"
    }
  }
}
